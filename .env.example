# Toasty self-hosting configuration — copy to .env and edit before `docker compose up -d`.

# --- Postgres ---------------------------------------------------------------

# Database role the app connects as.
POSTGRES_USER=toasty
# REQUIRED: strong, URL-safe password (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=change-me
# Database name.
POSTGRES_DB=toasty

# --- Public URL -------------------------------------------------------------

# The domain Caddy serves; edit docker/Caddyfile to match.
DOMAIN=toasty.example.com
# Exact browser origin(s) allowed by the API, comma-separated, no trailing slash.
CORS_ORIGIN=https://toasty.example.com

# --- Server tuning (names fixed by docs/api.md) ------------------------------

# How long a sign-in session stays valid, in hours.
SESSION_TTL_HOURS=24
# How many times a session can be extended (POST /api/auth/refresh) before re-login.
SESSION_MAX_REFRESHES=3
# Per-IP limit on /api/auth/* requests, per minute.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Trust X-Forwarded-For when behind Caddy or your own reverse proxy.
TRUST_PROXY=false

# --- Sign-ups ---------------------------------------------------------------

# The first run is a one-time setup (setup token from the server logs); completing it
# closes registration. Set true to reopen sign-ups for a multi-user instance.
ALLOW_REGISTRATION=false
